{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/": "deny",
      "rm -rf ~/*": "deny",
      "go *": "allow",
      "make *": "allow",
      "npm *": "allow",
      "grep": "allow",
      "ls": "allow",
      "cat": "allow"
    },
    "external_directory": {
      "~/tmp/99/": "allow",
      "~/tmp/99/*": "allow"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    }
  },
  "provider": {
    "opencode": {
      "blacklist": [
        "north-mini-code-free",
        "longcat-2.0-free",
        "ling-3.0-flash-free",
        "laguna-s-2.1-free",
        "deepseek-v4-flash-free",
        "mimo-v2.5-free",
        "big-pickle",
        "nemotron-3-ultra-free"
      ]
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "streaming": false
      },
      "models": {
        "qwen2.5-coder:14b-opencode": {
          "name": "Qwen2.5 Coder 14B",
          "tool_call": true
        }
      }
    }
  }
}
